#:import dp kivy.metrics.dp

<NexaCard@MDCard>:
    radius: [16, 16, 16, 16]
    elevation: 0
    md_bg_color: 1, 0.985, 1, 1
    padding: dp(18)
    ripple_behavior: True

<NexaSectionTitle@MDLabel>:
    bold: True
    theme_text_color: "Primary"
    font_size: "18sp"

<NexaMuted@MDLabel>:
    theme_text_color: "Secondary"
