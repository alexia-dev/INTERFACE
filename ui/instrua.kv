<InstruaScreen>:
    md_bg_color: 0.988, 0.973, 1, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "NEXA / INSTRUA"
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            md_bg_color: 0.388, 0.055, 0.831, 1
            specific_text_color: 1, 1, 1, 1

        MDScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(16) if self.width < dp(600) else dp(24)
                spacing: dp(12) if self.width < dp(600) else dp(14)
                size_hint_y: None
                height: self.minimum_height

                NexaTitle:
                    text: "Agenda e atendimento"
                    font_size: "21sp" if self.width < dp(600) else "22sp"

                NexaCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(285) if self.width < dp(600) else dp(240)

                    MDTextField:
                        id: patient_input
                        hint_text: "Nome do paciente"
                        mode: "rectangle"
                        size_hint_x: 1

                    MDTextField:
                        id: appointment_input
                        hint_text: "Consulta / procedimento"
                        mode: "rectangle"
                        size_hint_x: 1

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        NexaButton:
                            text: "AGENDAR"
                            size_hint_x: 1
                            on_release: root.add_appointment()

                        NexaButton:
                            text: "EXCLUIR ÚLTIMO"
                            size_hint_x: 1
                            on_release: root.delete_latest()

                    MDLabel:
                        id: appointment_status
                        text: "Nenhum novo agendamento."
                        theme_text_color: "Secondary"
                        text_size: self.width, None

                NexaSection:
                    text: "Próximos atendimentos"

                NexaCard:
                    size_hint_y: None
                    height: dp(190) if self.width < dp(600) else dp(170)

                    MDLabel:
                        id: recent_list
                        text: "Carregando..."
                        theme_text_color: "Secondary"
                        text_size: self.width, None
