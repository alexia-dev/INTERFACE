<InstruaScreen>:
    md_bg_color: 0.035, 0.018, 0.075, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "INSTRUA   |   Gestão • Agendamentos • Instruções"
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            md_bg_color: 0.06, 0.025, 0.12, 0.96
            specific_text_color: 1, 0.90, 1, 1

        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18) if self.width < dp(700) else dp(28)
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "Agenda e atendimento"
                    font_size: "30sp"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 0.75, 1, 1
                    size_hint_y: None
                    height: self.texture_size[1]

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(7)
                    ScrollView:
                        do_scroll_y: False
                        MDBoxLayout:
                            adaptive_width: True
                            spacing: dp(6)
                            NexaChip:
                                text: "Salão"
                            NexaChip:
                                text: "Clínica"
                            NexaChip:
                                text: "Oficina"
                            NexaChip:
                                text: "Consultoria"
                            NexaChip:
                                text: "Aulas"
                            NexaChip:
                                text: "Serviços"

                NexaCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(285) if self.width < dp(600) else dp(250)

                    MDLabel:
                        text: "Novo agendamento"
                        bold: True
                        font_size: "19sp"
                        theme_text_color: "Custom"
                        text_color: 0.95, 0.84, 1, 1
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDTextField:
                        id: patient_input
                        hint_text: "Selecionar cliente"
                        mode: "fill"
                        fill_color_normal: 0.10, 0.06, 0.18, 1
                        fill_color_focus: 0.13, 0.08, 0.24, 1
                        text_color_normal: 1, 1, 1, 1
                        hint_text_color_normal: 0.62, 0.55, 0.72, 1

                    MDTextField:
                        id: appointment_input
                        hint_text: "Serviço / procedimento"
                        mode: "fill"
                        fill_color_normal: 0.10, 0.06, 0.18, 1
                        fill_color_focus: 0.13, 0.08, 0.24, 1
                        text_color_normal: 1, 1, 1, 1
                        hint_text_color_normal: 0.62, 0.55, 0.72, 1

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)
                        NexaButton:
                            text: "AGENDAR"
                            on_release: root.add_appointment()
                        NexaButton:
                            text: "EXCLUIR ÚLTIMO"
                            on_release: root.delete_latest()

                    MDLabel:
                        id: appointment_status
                        text: "Nenhum novo agendamento."
                        theme_text_color: "Custom"
                        text_color: 0.62, 0.55, 0.72, 1
                        text_size: self.width, None

                NexaSection:
                    text: "Próximos atendimentos"

                NexaCard:
                    size_hint_y: None
                    height: dp(210)
                    MDLabel:
                        id: recent_list
                        text: "Carregando..."
                        theme_text_color: "Custom"
                        text_color: 0.82, 0.76, 0.88, 1
                        text_size: self.width, None
