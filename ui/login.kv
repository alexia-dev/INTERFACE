#:import dp kivy.metrics.dp

<LoginScreen>:
    md_bg_color: 0.031, 0.012, 0.06, 1

    MDBoxLayout:
        orientation: "horizontal"
        padding: dp(24)
        spacing: dp(28)

        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 1.15
            padding: dp(22)
            spacing: dp(16)
            canvas.before:
                Color:
                    rgba: 0.10, 0.025, 0.18, 0.55
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(24), dp(24), dp(24), dp(24)]

            MDLabel:
                text: "NEXA • DEMO RESPONSIVA"
                theme_text_color: "Custom"
                text_color: 0.78, 0.61, 1, 1
                font_size: "11sp"
                bold: True
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Seu ecossistema.\n[font=Roboto][color=#ff63d2]Do seu jeito.[/color][/font]"
                markup: True
                theme_text_color: "Custom"
                text_color: 0.98, 0.96, 1, 1
                font_size: "42sp"
                size_hint_y: None
                height: dp(110)

            MDLabel:
                text: "Uma prévia da Central NEXA para acessar aplicativos independentes usando uma única conta."
                theme_text_color: "Custom"
                text_color: 0.74, 0.67, 0.80, 1
                font_size: "14sp"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "• Uma conta para o ecossistema\n• Aplicativos independentes\n• Controle de acesso e planos\n• Experiência desktop + mobile"
                theme_text_color: "Custom"
                text_color: 0.70, 0.63, 0.76, 1
                font_size: "13sp"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            Widget:

        MDCard:
            size_hint_x: 0.85
            padding: dp(24)
            radius: [dp(22), dp(22), dp(22), dp(22)]
            elevation: 0
            md_bg_color: 0.13, 0.06, 0.20, 0.93
            line_color: 0.77, 0.55, 1, 0.18

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)

                Widget:
                    size_hint_y: None
                    height: dp(12)

                MDCard:
                    size_hint: None, None
                    size: dp(95), dp(95)
                    pos_hint: {"center_x": .5}
                    radius: [dp(28), dp(28), dp(28), dp(28)]
                    elevation: 0
                    md_bg_color: 0.40, 0.14, 0.55, 0.28
                    line_color: 1, 0.39, 0.82, 0.20
                    MDLabel:
                        text: "◈"
                        halign: "center"
                        valign: "middle"
                        font_size: "40sp"
                        theme_text_color: "Custom"
                        text_color: 0.96, 0.72, 1, 1

                MDLabel:
                    text: "Entrar na NEXA"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.98, 0.96, 1, 1
                    font_size: "23sp"

                MDLabel:
                    text: "Ambiente local — dados fictícios."
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.68, 0.60, 0.74, 1
                    font_size: "11sp"

                MDTextField:
                    id: email_input
                    hint_text: "E-mail"
                    mode: "fill"
                    fill_color_normal: 0.03, 0.01, 0.06, 0.72
                    fill_color_focus: 0.10, 0.04, 0.16, 1
                    line_color_focus: 0.66, 0.42, 1, 1

                MDTextField:
                    id: password_input
                    hint_text: "Senha"
                    password: True
                    mode: "fill"
                    fill_color_normal: 0.03, 0.01, 0.06, 0.72
                    fill_color_focus: 0.10, 0.04, 0.16, 1
                    line_color_focus: 0.66, 0.42, 1, 1

                MDRaisedButton:
                    text: "ENTRAR NA DEMO"
                    size_hint_y: None
                    height: dp(48)
                    radius: [dp(12), dp(12), dp(12), dp(12)]
                    elevation: 0
                    pos_hint: {"center_x": .5}
                    md_bg_color: 0.70, 0.22, 0.75, 1
                    on_release: root.login()

                MDLabel:
                    id: login_status
                    text: "🛡  AMBIENTE DE TESTE • dados fictícios"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.42, 0.87, 0.73, 1
                    font_size: "10sp"
