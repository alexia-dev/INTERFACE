<BillScreen>:
    md_bg_color: 0.988, 0.973, 1, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "NEXA / NEXA BILL"
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            md_bg_color: 0.388, 0.055, 0.831, 1
            specific_text_color: 1, 1, 1, 1

        MDScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(16) if self.width < dp(600) else dp(24)
                spacing: dp(12) if self.width < dp(600) else dp(14)
                size_hint_y: None
                height: self.minimum_height

                NexaTitle:
                    text: "Faturamento"
                    font_size: "21sp" if self.width < dp(600) else "22sp"

                NexaCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(250) if self.width < dp(600) else dp(210)

                    MDTextField:
                        id: bill_patient
                        hint_text: "Paciente / atendimento"
                        mode: "rectangle"
                        size_hint_x: 1

                    MDTextField:
                        id: bill_value
                        hint_text: "Valor (ex.: 350,00)"
                        mode: "rectangle"
                        input_type: "number"
                        size_hint_x: 1

                    NexaButton:
                        text: "LANÇAR FATURAMENTO"
                        size_hint_x: 1
                        on_release: root.add_bill()

                    MDLabel:
                        id: bill_status
                        text: "Nenhum lançamento nesta sessão."
                        theme_text_color: "Secondary"
                        text_size: self.width, None

                NexaSection:
                    text: "Lançamentos recentes"

                NexaCard:
                    size_hint_y: None
                    height: dp(190) if self.width < dp(600) else dp(170)

                    MDLabel:
                        id: recent_billing
                        text: "Carregando..."
                        theme_text_color: "Secondary"
                        text_size: self.width, None
