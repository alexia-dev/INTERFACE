#:import dp kivy.metrics.dp

<CentralScreen>:
    md_bg_color: app.bg_color

    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "NEXA CENTRAL   |   Pesquisa"
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            right_action_items: [["theme-light-dark", lambda x: app.toggle_theme()]]
            md_bg_color: app.surface_color
            specific_text_color: 1, 0.90, 1, 1
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18) if self.width < dp(700) else dp(28)
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height
                NexaTitle:
                    text: "Pesquisa unificada"
                MDTextField:
                    id: search_input
                    hint_text: "Pesquisar cliente, atendimento ou relatório"
                    mode: "fill"
                    fill_color_normal: app.surface_color
                    fill_color_focus: app.card_color
                NexaButton:
                    text: "PESQUISAR"
                    on_release: root.search()
                NexaCard:
                    size_hint_y: None
                    height: dp(220)
                    MDLabel:
                        id: search_result
                        text: "Digite algo para pesquisar nos dados locais."
                        theme_text_color: "Custom"
                        text_color: app.muted_color
                        text_size: self.width, None
