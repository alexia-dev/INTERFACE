<CentralScreen>:
    md_bg_color: 0.035, 0.018, 0.075, 1

    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "NEXA CENTRAL   |   Pesquisa"
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            md_bg_color: 0.06, 0.025, 0.12, 0.96
            specific_text_color: 1, 0.90, 1, 1
        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18) if self.width < dp(700) else dp(28)
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height
                NexaTitle:
                    text: "Pesquisa unificada"
                MDTextField:
                    id: search_input
                    hint_text: "Pesquisar cliente, atendimento ou relatório"
                    mode: "fill"
                    fill_color_normal: 0.10, 0.06, 0.18, 1
                    fill_color_focus: 0.13, 0.08, 0.24, 1
                NexaButton:
                    text: "PESQUISAR"
                    on_release: root.search()
                NexaCard:
                    size_hint_y: None
                    height: dp(220)
                    MDLabel:
                        id: search_result
                        text: "Digite algo para pesquisar nos dados locais."
                        theme_text_color: "Custom"
                        text_color: 0.82, 0.76, 0.88, 1
                        text_size: self.width, None
