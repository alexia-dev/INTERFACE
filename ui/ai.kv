#:import dp kivy.metrics.dp

<MDScreen>:

MDScreen:
    name: "ai"
    md_bg_color: app.bg_color
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "✦  NEXA AI"
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            md_bg_color: app.surface_color
        MDBoxLayout:
            orientation: "vertical"
            padding: dp(20)
            spacing: dp(12)
            MDLabel:
                text: "Seu copiloto operacional"
                font_size: "24sp"
                bold: True
                theme_text_color: "Custom"
                text_color: app.text_color
                size_hint_y: None
                height: self.texture_size[1]
            MDLabel:
                text: root.response if hasattr(root, "response") else ""
                theme_text_color: "Custom"
                text_color: app.muted_color
            MDTextField:
                id: ai_message
                hint_text: "Ex.: quais lançamentos tenho?"
                mode: "rectangle"
                size_hint_y: None
                height: dp(58)
            MDRaisedButton:
                text: "Perguntar"
                on_release: root.ask()
                size_hint_y: None
                height: dp(48)
