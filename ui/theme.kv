#:import dp kivy.metrics.dp

<NexaCard@MDCard>:
    radius: [16, 16, 16, 16]
    elevation: 0
    md_bg_color: 1, 1, 1, 1
    padding: dp(18)

<NexaTitle@MDLabel>:
    bold: True
    font_size: "22sp"
    theme_text_color: "Primary"

<NexaSection@MDLabel>:
    bold: True
    font_size: "18sp"
    theme_text_color: "Primary"

<NexaButton@MDRaisedButton>:
    md_bg_color: 0.388, 0.055, 0.831, 1
