#:import dp kivy.metrics.dp

<QuickCard@MDCard>:
    size_hint_y: None
    height: dp(112)
    radius: [dp(18), dp(18), dp(18), dp(18)]
    elevation: 0
    padding: dp(16)
    md_bg_color: 0.13, 0.06, 0.20, 0.88
    line_color: 0.77, 0.55, 1, 0.18

<StatCard@MDCard>:
    size_hint_y: None
    height: dp(92)
    radius: [dp(15), dp(15), dp(15), dp(15)]
    elevation: 0
    padding: dp(15)
    md_bg_color: 0.13, 0.06, 0.20, 0.82
    line_color: 0.77, 0.55, 1, 0.16

MDScreen:
    name: "home"
    md_bg_color: 0.031, 0.012, 0.06, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "◈  NEXA"
            left_action_items: [["menu", lambda x: app.open_menu()]]
            right_action_items: [["theme-light-dark", lambda x: app.toggle_theme()]]
            md_bg_color: 0.035, 0.012, 0.07, 0.78
            specific_text_color: 0.98, 0.96, 1, 1

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(22)
                spacing: dp(14)

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(7)
                    ScrollView:
                        do_scroll_y: False
                        MDBoxLayout:
                            adaptive_width: True
                            spacing: dp(7)
                            OneLineChip:
                                text: "Instrua"
                            OneLineChip:
                                text: "Nexa Bill"
                            OneLineChip:
                                text: "Nexa AI"
                            OneLineChip:
                                text: "Nexa Study"
                            OneLineChip:
                                text: "Nexa Work"

                MDLabel:
                    text: "NEXA CENTRAL"
                    theme_text_color: "Custom"
                    text_color: 0.78, 0.61, 1, 1
                    font_size: "11sp"
                    bold: True
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Olá, Aléxia 👋"
                    theme_text_color: "Custom"
                    text_color: 0.98, 0.96, 1, 1
                    font_size: "38sp"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Seu ecossistema em um só lugar."
                    theme_text_color: "Custom"
                    text_color: 0.72, 0.65, 0.78, 1
                    font_size: "14sp"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDGridLayout:
                    cols: 4 if self.width > dp(900) else 2
                    adaptive_height: True
                    spacing: dp(10)

                    StatCard:
                        MDLabel:
                            text: "05"
                            font_size: "23sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.98, 0.96, 1, 1
                        MDLabel:
                            text: "Aplicativos"
                            font_size: "10sp"
                            theme_text_color: "Custom"
                            text_color: 0.64, 0.56, 0.70, 1

                    StatCard:
                        MDLabel:
                            text: "04"
                            font_size: "23sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.98, 0.96, 1, 1
                        MDLabel:
                            text: "Ativos"
                            font_size: "10sp"
                            theme_text_color: "Custom"
                            text_color: 0.64, 0.56, 0.70, 1

                    StatCard:
                        MDLabel:
                            text: "12"
                            font_size: "23sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.98, 0.96, 1, 1
                        MDLabel:
                            text: "Notificações"
                            font_size: "10sp"
                            theme_text_color: "Custom"
                            text_color: 0.64, 0.56, 0.70, 1

                    StatCard:
                        MDLabel:
                            text: "100%"
                            font_size: "23sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.98, 0.96, 1, 1
                        MDLabel:
                            text: "Conta verificada"
                            font_size: "10sp"
                            theme_text_color: "Custom"
                            text_color: 0.64, 0.56, 0.70, 1

                MDGridLayout:
                    cols: 2 if self.width > dp(760) else 1
                    adaptive_height: True
                    spacing: dp(14)

                    MDCard:
                        size_hint_y: None
                        height: dp(285)
                        radius: [dp(20), dp(20), dp(20), dp(20)]
                        elevation: 0
                        padding: dp(18)
                        md_bg_color: 0.13, 0.06, 0.20, 0.88
                        line_color: 0.77, 0.55, 1, 0.18

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(9)

                            MDLabel:
                                text: "Aplicativos recentes"
                                font_size: "16sp"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.98, 0.96, 1, 1
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDCard:
                                size_hint_y: None
                                height: dp(58)
                                radius: [dp(12), dp(12), dp(12), dp(12)]
                                elevation: 0
                                padding: dp(12)
                                md_bg_color: 0.20, 0.12, 0.28, 0.35
                                on_release: app.open_module("Instrua")
                                MDBoxLayout:
                                    MDLabel:
                                        text: "🦊 Instrua\n[color=#9e8aaa]Gestão • Agendamentos[/color]"
                                        markup: True
                                        theme_text_color: "Custom"
                                        text_color: 1, 1, 1, 1
                                    MDLabel:
                                        text: "Ativo"
                                        halign: "right"
                                        theme_text_color: "Custom"
                                        text_color: 0.45, 0.88, 0.76, 1

                            MDCard:
                                size_hint_y: None
                                height: dp(58)
                                radius: [dp(12), dp(12), dp(12), dp(12)]
                                elevation: 0
                                padding: dp(12)
                                md_bg_color: 0.20, 0.12, 0.28, 0.35
                                on_release: app.open_module("Nexa Bill")
                                MDBoxLayout:
                                    MDLabel:
                                        text: "▣ Nexa Bill\n[color=#9e8aaa]Faturamento • Relatórios[/color]"
                                        markup: True
                                        theme_text_color: "Custom"
                                        text_color: 1, 1, 1, 1
                                    MDLabel:
                                        text: "Ativo"
                                        halign: "right"
                                        theme_text_color: "Custom"
                                        text_color: 0.45, 0.88, 0.76, 1

                            MDCard:
                                size_hint_y: None
                                height: dp(58)
                                radius: [dp(12), dp(12), dp(12), dp(12)]
                                elevation: 0
                                padding: dp(12)
                                md_bg_color: 0.20, 0.12, 0.28, 0.35
                                MDBoxLayout:
                                    MDLabel:
                                        text: "✦ Nexa AI\n[color=#9e8aaa]Assistente inteligente[/color]"
                                        markup: True
                                        theme_text_color: "Custom"
                                        text_color: 1, 1, 1, 1
                                    MDLabel:
                                        text: "Disponível"
                                        halign: "right"
                                        theme_text_color: "Custom"
                                        text_color: 0.45, 0.88, 0.76, 1

                    MDCard:
                        size_hint_y: None
                        height: dp(285)
                        radius: [dp(20), dp(20), dp(20), dp(20)]
                        elevation: 0
                        padding: dp(18)
                        md_bg_color: 0.13, 0.06, 0.20, 0.88
                        line_color: 0.77, 0.55, 1, 0.18

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(10)

                            MDLabel:
                                text: "Acesso rápido"
                                font_size: "16sp"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.98, 0.96, 1, 1
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDGridLayout:
                                cols: 2
                                spacing: dp(9)
                                adaptive_height: True

                                QuickCard:
                                    on_release: app.open_module("Central")
                                    MDLabel:
                                        text: "▦"
                                        halign: "center"
                                        font_size: "24sp"
                                        theme_text_color: "Custom"
                                        text_color: 0.78, 0.50, 1, 1
                                    MDLabel:
                                        text: "Meus apps"
                                        halign: "center"
                                        font_size: "10sp"
                                        theme_text_color: "Custom"
                                        text_color: 0.82, 0.76, 0.88, 1

                                QuickCard:
                                    on_release: app.open_module("Nexa Bill")
                                    MDLabel:
                                        text: "◷"
                                        halign: "center"
                                        font_size: "24sp"
                                        theme_text_color: "Custom"
                                        text_color: 1, 0.40, 0.82, 1
                                    MDLabel:
                                        text: "Atividade"
                                        halign: "center"
                                        font_size: "10sp"
                                        theme_text_color: "Custom"
                                        text_color: 0.82, 0.76, 0.88, 1

                                QuickCard:
                                    on_release: app.show_help()
                                    MDLabel:
                                        text: "◎"
                                        halign: "center"
                                        font_size: "24sp"
                                        theme_text_color: "Custom"
                                        text_color: 0.38, 0.65, 1, 1
                                    MDLabel:
                                        text: "Minha conta"
                                        halign: "center"
                                        font_size: "10sp"
                                        theme_text_color: "Custom"
                                        text_color: 0.82, 0.76, 0.88, 1

                                QuickCard:
                                    on_release: app.open_module("Instrua")
                                    MDLabel:
                                        text: "🦊"
                                        halign: "center"
                                        font_size: "22sp"
                                        theme_text_color: "Custom"
                                        text_color: 1, 0.50, 0.83, 1
                                    MDLabel:
                                        text: "Instrua"
                                        halign: "center"
                                        font_size: "10sp"
                                        theme_text_color: "Custom"
                                        text_color: 0.82, 0.76, 0.88, 1
