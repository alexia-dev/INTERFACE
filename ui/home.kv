<HomeScreen>:
    md_bg_color: 0.988, 0.973, 1, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "NEXA"
            left_action_items: [["menu", lambda x: app.open_menu()]]
            right_action_items: [["help-circle-outline", lambda x: app.show_help()]]
            md_bg_color: 0.388, 0.055, 0.831, 1
            specific_text_color: 1, 1, 1, 1
            elevation: 0

        MDScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(16) if self.width < dp(600) else dp(28)
                spacing: dp(14) if self.width < dp(600) else dp(18)
                size_hint_y: None
                height: self.minimum_height

                NexaTitle:
                    text: "NEXA — seu ecossistema de aplicativos"
                    font_size: "22sp" if self.width < dp(600) else "24sp"
                    text_size: self.width, None

                MDLabel:
                    text: "Aplicativos independentes, conectados por uma conta e serviços NEXA."
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None

                MDGridLayout:
                    cols: 1 if self.width < dp(720) else 2
                    spacing: dp(12) if self.width < dp(600) else dp(16)
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: dp(176) if self.width < dp(600) else dp(170)
                    row_force_default: True

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "INSTRUA"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Agenda, pacientes, confirmações e instruções."
                            theme_text_color: "Secondary"
                            text_size: self.width, None
                        Widget:
                        NexaButton:
                            text: "ABRIR INSTRUA"
                            size_hint_x: 1
                            on_release: app.open_module("Instrua")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "NEXA BILL"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Faturamento, lotes, guias e protocolos."
                            theme_text_color: "Secondary"
                            text_size: self.width, None
                        Widget:
                        NexaButton:
                            text: "ABRIR FATURAMENTO"
                            size_hint_x: 1
                            on_release: app.open_module("Nexa Bill")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "NEXA ADMIN"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Gestão, relatórios e administração."
                            theme_text_color: "Secondary"
                            text_size: self.width, None
                        Widget:
                        NexaButton:
                            text: "ABRIR GESTÃO"
                            size_hint_x: 1
                            on_release: app.open_module("Nexa Admin")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "CENTRAL"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Pesquisa e visão unificada dos dados."
                            theme_text_color: "Secondary"
                            text_size: self.width, None
                        Widget:
                        NexaButton:
                            text: "ABRIR CENTRAL"
                            size_hint_x: 1
                            on_release: app.open_module("Central")

                NexaCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(150)

                    NexaSection:
                        text: "ECOSSISTEMA NEXA"

                    MDBoxLayout:
                        spacing: dp(8)
                        padding: dp(6), dp(8)

                        MDLabel:
                            text: "NEXA\\nPlataforma"
                            halign: "center"
                            theme_text_color: "Secondary"
                            font_size: "12sp" if self.width < dp(600) else "14sp"
                        MDLabel:
                            text: "Instrua\\nClínico"
                            halign: "center"
                            theme_text_color: "Secondary"
                            font_size: "12sp" if self.width < dp(600) else "14sp"
                        MDLabel:
                            text: "Nexa Bill\\nFaturamento"
                            halign: "center"
                            theme_text_color: "Secondary"
                            font_size: "12sp" if self.width < dp(600) else "14sp"
                        MDLabel:
                            text: "Nexa Admin\\nGestão"
                            halign: "center"
                            theme_text_color: "Secondary"
                            font_size: "12sp" if self.width < dp(600) else "14sp"
