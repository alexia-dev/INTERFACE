<HomeScreen>:
    md_bg_color: 0.988, 0.973, 1, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "NEXA"
            left_action_items: [["menu", lambda x: app.open_menu()]]
            right_action_items: [["help-circle-outline", lambda x: app.show_help()]]
            md_bg_color: 0.388, 0.055, 0.831, 1
            specific_text_color: 1, 1, 1, 1
            elevation: 0

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "28dp"
                spacing: "18dp"
                size_hint_y: None
                height: self.minimum_height

                NexaTitle:
                    text: "NEXA — Plataforma de Gestão para Clínicas"

                MDLabel:
                    text: "Um ecossistema modular para atendimento, faturamento e gestão."
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDGridLayout:
                    cols: 2
                    spacing: "16dp"
                    size_hint_y: None
                    height: "260dp"

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "INSTRUA"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Agenda, pacientes, confirmações e instruções."
                            theme_text_color: "Secondary"
                        Widget:
                        NexaButton:
                            text: "ABRIR INSTRUA"
                            on_release: app.open_module("Instrua")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "NEXA BILL"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Faturamento, lotes, guias e protocolos."
                            theme_text_color: "Secondary"
                        Widget:
                        NexaButton:
                            text: "ABRIR FATURAMENTO"
                            on_release: app.open_module("Nexa Bill")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "NEXA ADMIN"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Gestão, relatórios e administração."
                            theme_text_color: "Secondary"
                        Widget:
                        NexaButton:
                            text: "ABRIR GESTÃO"
                            on_release: app.open_module("Nexa Admin")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "CENTRAL"
                            bold: True
                            font_size: "18sp"
                            theme_text_color: "Primary"
                        MDLabel:
                            text: "Pesquisa e visão unificada dos dados."
                            theme_text_color: "Secondary"
                        Widget:
                        NexaButton:
                            text: "ABRIR CENTRAL"
                            on_release: app.open_module("Central")

                NexaCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "150dp"

                    NexaSection:
                        text: "VISÃO DA PLATAFORMA"

                    MDBoxLayout:
                        spacing: "12dp"
                        padding: "8dp", "12dp"

                        MDLabel:
                            text: "NEXA\\nPlataforma"
                            halign: "center"
                            theme_text_color: "Secondary"
                        MDLabel:
                            text: "Instrua\\nClínico"
                            halign: "center"
                            theme_text_color: "Secondary"
                        MDLabel:
                            text: "Nexa Bill\\nFaturamento"
                            halign: "center"
                            theme_text_color: "Secondary"
                        MDLabel:
                            text: "Nexa Admin\\nGestão"
                            halign: "center"
                            theme_text_color: "Secondary"
