#:import dp kivy.metrics.dp

<QuickCard@MDCard>:
    size_hint_y: None
    height: dp(118)
    radius: [18, 18, 18, 18]
    elevation: 2
    md_bg_color: app.card_color
    padding: dp(14)

MDScreen:
    name: "home"
    md_bg_color: app.bg_color

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "NEXA"
            left_action_items: [["menu", lambda x: app.open_menu()]]
            right_action_items: [["theme-light-dark", lambda x: app.toggle_theme()]]
            md_bg_color: app.surface_color
            specific_text_color: app.text_color

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(18)
                spacing: dp(14)

                MDLabel:
                    text: "Seu ecossistema em um só lugar"
                    font_style: "H4"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.text_color
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Acesse seus aplicativos, acompanhe a operação e deixe o NEXA cuidar do trabalho repetitivo."
                    theme_text_color: "Custom"
                    text_color: app.muted_color
                    size_hint_y: None
                    height: self.texture_size[1]

                MDGridLayout:
                    cols: 2 if self.width > dp(640) else 1
                    adaptive_height: True
                    spacing: dp(12)

                    QuickCard:
                        on_release: app.open_module("Instrua")
                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(5)
                            MDLabel:
                                text: "✦  INSTRUA"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.95, 0.55, 1, 1
                            MDLabel:
                                text: "Jornada do cliente, agenda, confirmações e instruções."
                                theme_text_color: "Custom"
                                text_color: app.muted_color
                            MDLabel:
                                text: "Abrir aplicativo  →"
                                theme_text_color: "Custom"
                                text_color: app.text_color

                    QuickCard:
                        on_release: app.open_module("Nexa Bill")
                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(5)
                            MDLabel:
                                text: "▣  NEXA BILL"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.98, 0.78, 0.45, 1
                            MDLabel:
                                text: "Faturamento, lotes, protocolos, conferência e relatórios."
                                theme_text_color: "Custom"
                                text_color: app.muted_color
                            MDLabel:
                                text: "Abrir aplicativo  →"
                                theme_text_color: "Custom"
                                text_color: app.text_color

                    QuickCard:
                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(5)
                            MDLabel:
                                text: "◈  NEXA AI"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.45, 0.78, 1, 1
                            MDLabel:
                                text: "Assistente para consultar dados e preparar tarefas."
                                theme_text_color: "Custom"
                                text_color: app.muted_color
                            MDLabel:
                                text: "Em preparação"
                                theme_text_color: "Custom"
                                text_color: app.muted_color

                    QuickCard:
                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(5)
                            MDLabel:
                                text: "⌘  AUTOMATION"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.7, 0.6, 1, 1
                            MDLabel:
                                text: "Ações automáticas para notificações e rotinas repetitivas."
                                theme_text_color: "Custom"
                                text_color: app.muted_color
                            MDLabel:
                                text: "Base do ecossistema"
                                theme_text_color: "Custom"
                                text_color: app.muted_color

                MDLabel:
                    text: "Resumo da operação"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.text_color
                    size_hint_y: None
                    height: self.texture_size[1]

                MDGridLayout:
                    cols: 3 if self.width > dp(720) else 1
                    adaptive_height: True
                    spacing: dp(10)

                    QuickCard:
                        height: dp(96)
                        MDLabel:
                            text: "Identidade\nConta NEXA"
                            theme_text_color: "Custom"
                            text_color: app.text_color
                    QuickCard:
                        height: dp(96)
                        MDLabel:
                            text: "Organizações\nAcesso por empresa"
                            theme_text_color: "Custom"
                            text_color: app.text_color
                    QuickCard:
                        height: dp(96)
                        MDLabel:
                            text: "Entitlements\nPlano e recursos"
                            theme_text_color: "Custom"
                            text_color: app.text_color

                Widget:
                    size_hint_y: None
                    height: dp(12)
