<HomeScreen>:
    md_bg_color: 0.035, 0.018, 0.075, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "🦊  NEXA   |   Automação e análise de dados para o seu negócio"
            left_action_items: [["menu", lambda x: app.open_menu()]]
            right_action_items: [["help-circle-outline", lambda x: app.show_help()]]
            md_bg_color: 0.06, 0.025, 0.12, 0.96
            specific_text_color: 1, 0.90, 1, 1
            elevation: 0

        MDScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18) if self.width < dp(700) else dp(30)
                spacing: dp(16)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "NEXA"
                    font_size: "38sp" if self.width < dp(700) else "46sp"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.98, 0.72, 1, 1
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Automação e análise de dados para o seu negócio"
                    font_size: "15sp"
                    theme_text_color: "Custom"
                    text_color: 0.78, 0.70, 0.86, 1
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    ScrollView:
                        do_scroll_y: False
                        MDBoxLayout:
                            adaptive_width: True
                            spacing: dp(7)
                            NexaChip:
                                text: "Vendas"
                            NexaChip:
                                text: "Serviços"
                            NexaChip:
                                text: "Financeiro"
                            NexaChip:
                                text: "Estoque"
                            NexaChip:
                                text: "Clientes"
                            NexaChip:
                                text: "Faturamento"
                            NexaChip:
                                text: "Relatórios"

                MDGridLayout:
                    cols: 1 if self.width < dp(700) else 2
                    spacing: dp(14)
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: dp(205)
                    row_force_default: True

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "🦊  NEXA"
                            font_size: "22sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 0.75, 1, 1
                        MDLabel:
                            text: "Bem-vinda!\\nAutomatize seus dados, gere relatórios e transforme informação em decisões."
                            theme_text_color: "Custom"
                            text_color: 0.78, 0.72, 0.86, 1
                            text_size: self.width, None
                        Widget:
                        NexaButton:
                            text: "PROCESSAR DADOS"
                            on_release: app.toast("Módulo de processamento aberto.")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "NEXA BILL"
                            font_size: "22sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.92, 0.70, 1, 1
                        MDLabel:
                            text: "Faturamento, lotes, guias, protocolos e relatórios."
                            theme_text_color: "Custom"
                            text_color: 0.78, 0.72, 0.86, 1
                            text_size: self.width, None
                        Widget:
                        NexaButton:
                            text: "ABRIR FATURAMENTO"
                            on_release: app.open_module("Nexa Bill")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "INSTRUA"
                            font_size: "22sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.92, 0.70, 1, 1
                        MDLabel:
                            text: "Agenda, clientes, serviços, confirmações e instruções."
                            theme_text_color: "Custom"
                            text_color: 0.78, 0.72, 0.86, 1
                            text_size: self.width, None
                        Widget:
                        NexaButton:
                            text: "ABRIR INSTRUA"
                            on_release: app.open_module("Instrua")

                    NexaCard:
                        orientation: "vertical"
                        MDLabel:
                            text: "ADMIN + CENTRAL"
                            font_size: "22sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.92, 0.70, 1, 1
                        MDLabel:
                            text: "Gestão, pesquisa e visão unificada."
                            theme_text_color: "Custom"
                            text_color: 0.78, 0.72, 0.86, 1
                            text_size: self.width, None
                        Widget:
                        MDBoxLayout:
                            adaptive_height: True
                            spacing: dp(8)
                            NexaButton:
                                text: "ADMIN"
                                on_release: app.open_module("Nexa Admin")
                            NexaButton:
                                text: "CENTRAL"
                                on_release: app.open_module("Central")
